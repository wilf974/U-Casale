# Production Environment Variables
# Copy this file to .env and fill in the values

# PostgreSQL Database
POSTGRES_USER=ucasale
POSTGRES_PASSWORD=CHANGEME_SECURE_PASSWORD_HERE
POSTGRES_DB=ucasale_db

# NextAuth.js
NEXTAUTH_URL=https://ucasale.woutils.com
NEXTAUTH_SECRET=CHANGEME_GENERATE_WITH_openssl_rand_base64_32

# Stripe Payment
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email Configuration (SMTP)
EMAIL_SERVER_HOST=smtp.example.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=noreply@ucasale.woutils.com
EMAIL_SERVER_PASSWORD=your-email-password
EMAIL_FROM=noreply@ucasale.woutils.com

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://ucasale.woutils.com

# SSL Email for Let's Encrypt
SSL_EMAIL=admin@ucasale.woutils.com

# Domain
DOMAIN=ucasale.woutils.com
